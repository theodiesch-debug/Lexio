{
  "expo": {
    "name": "Lexio",
    "slug": "lexio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lexio",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.theodiesch.lexio",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#4C3220",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4C3220",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 110
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#e7b14a",
          "defaultChannel": "lexio-erinnerung"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lexio braucht Zugriff auf deine Fotos, um Vokabeln von einem Bild zu übernehmen.",
          "cameraPermission": "Lexio braucht die Kamera, um Vokabeln zu fotografieren.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
